<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cc-reaper.resource-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.cc-reaper/resource-watch.sh</string>
    </array>

    <!-- Run every 180 seconds (3 minutes), the cadence deployed on 2026-10-29 -->
    <key>StartInterval</key>
    <integer>180</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- The disk guard runs reclaim-byproducts.sh, which calls go and docker. The two
         thresholds are the values deployed on 2026-10-29, taken into the repository so the
         installer stops reverting them (script defaults: 20 GB and 20 GB/h) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>CC_RW_DISK_EMERGENCY_GB</key>
        <string>25</string>
        <key>CC_RW_RATE_FLAG_GBH</key>
        <string>12</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Run at reduced scheduling priority -->
    <key>Nice</key>
    <integer>10</integer>

    <!-- Reduce I/O priority so disk sampling does not compete with foreground work -->
    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.cc-reaper/logs/launchd-resource-watch-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.cc-reaper/logs/launchd-resource-watch-stderr.log</string>
</dict>
</plist>
