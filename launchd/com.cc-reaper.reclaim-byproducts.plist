<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cc-reaper.reclaim-byproducts</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__HOME__/.cc-reaper/reclaim-byproducts.sh</string><string>--if-stale</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>BYPRODUCT_MIN_MINUTES</key><string>60</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>7200</integer>
  <key>StandardOutPath</key><string>__HOME__/.claude/logs/reclaim-byproducts.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude/logs/reclaim-byproducts.log</string>
</dict>
</plist>
